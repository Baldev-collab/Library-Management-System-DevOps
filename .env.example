# ===================================================================
# Environment Configuration Template for Library Management System
# Copy this file to .env and adjust variables as needed for local run.
# ===================================================================

# Application Port
APP_PORT=8082

# Host MySQL Port mapping (3307 by default to avoid conflicting with existing port 3306 services)
MYSQL_LOCAL_PORT=3307

# MySQL Database Configuration
MYSQL_DATABASE=librarydb
MYSQL_USER=libraryuser
MYSQL_PASSWORD=librarypass
MYSQL_ROOT_PASSWORD=rootpassword

# Spring Boot Datasource Connection
# For Docker Compose:
DB_URL=jdbc:mysql://library-mysql:3306/librarydb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# For Local Host execution (when running outside docker):
# DB_URL=jdbc:mysql://localhost:3307/librarydb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

DB_USERNAME=libraryuser
DB_PASSWORD=librarypass
